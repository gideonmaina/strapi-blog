{
	"kind": "collectionType",
	"collectionName": "categories",
	"info": {
		"singularName": "category",
		"pluralName": "categories",
		"displayName": "Category",
		"description": "Blog post categories"
	},
	"options": {
		"draftAndPublish": false
	},
	"pluginOptions": {
		"i18n": {
			"localized": true
		}
	},
	"attributes": {
		"name": {
			"type": "string",
			"required": true,
			"unique": true,
			"maxLength": 100,
			"pluginOptions": {
				"i18n": {
					"localized": true
				}
			}
		},
		"slug": {
			"type": "uid",
			"targetField": "name",
			"required": true
		},
		"description": {
			"type": "text",
			"maxLength": 500,
			"pluginOptions": {
				"i18n": {
					"localized": true
				}
			}
		},
		"color": {
			"type": "string",
			"default": "#6B7280",
			"regex": "^#([A-Fa-f0-9]{6}|[A-Fa-f0-9]{3})$"
		},
		"icon": {
			"type": "string",
			"maxLength": 50
		},
		"blog_posts": {
			"type": "relation",
			"relation": "oneToMany",
			"target": "api::blog-post.blog-post",
			"mappedBy": "category"
		}
	}
}
