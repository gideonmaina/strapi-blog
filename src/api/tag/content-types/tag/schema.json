{
	"kind": "collectionType",
	"collectionName": "tags",
	"info": {
		"singularName": "tag",
		"pluralName": "tags",
		"displayName": "Tag",
		"description": "Blog post tags for better organization"
	},
	"options": {
		"draftAndPublish": false
	},
	"pluginOptions": {
		"i18n": {
			"localized": true
		}
	},
	"attributes": {
		"name": {
			"type": "string",
			"required": true,
			"unique": true,
			"maxLength": 50,
			"pluginOptions": {
				"i18n": {
					"localized": true
				}
			}
		},
		"slug": {
			"type": "uid",
			"targetField": "name",
			"required": true
		},
		"description": {
			"type": "text",
			"maxLength": 300,
			"pluginOptions": {
				"i18n": {
					"localized": true
				}
			}
		},
		"color": {
			"type": "string",
			"default": "#6B7280",
			"regex": "^#([A-Fa-f0-9]{6}|[A-Fa-f0-9]{3})$"
		},
		"blog_posts": {
			"type": "relation",
			"relation": "manyToMany",
			"target": "api::blog-post.blog-post",
			"inversedBy": "tags"
		},
		"projects": {
			"type": "relation",
			"relation": "manyToMany",
			"target": "api::project.project",
			"mappedBy": "tags"
		}
	}
}
