{
	"kind": "collectionType",
	"collectionName": "authors",
	"info": {
		"singularName": "author",
		"pluralName": "authors",
		"displayName": "Author",
		"description": "Blog post authors"
	},
	"options": {
		"draftAndPublish": false
	},
	"pluginOptions": {
		"i18n": {
			"localized": true
		}
	},
	"attributes": {
		"name": {
			"type": "string",
			"required": true,
			"maxLength": 100,
			"pluginOptions": {
				"i18n": {
					"localized": true
				}
			}
		},
		"slug": {
			"type": "uid",
			"targetField": "name",
			"required": true
		},
		"bio": {
			"type": "text",
			"maxLength": 1000,
			"pluginOptions": {
				"i18n": {
					"localized": true
				}
			}
		},
		"email": {
			"type": "email",
			"required": false
		},
		"avatar": {
			"type": "media",
			"multiple": false,
			"required": false,
			"allowedTypes": [
				"images"
			]
		},
		"social": {
			"type": "json",
			"required": false
		},
		"title": {
			"type": "string",
			"maxLength": 100,
			"pluginOptions": {
				"i18n": {
					"localized": true
				}
			}
		},
		"website": {
			"type": "string",
			"maxLength": 255
		},
		"blog_posts": {
			"type": "relation",
			"relation": "oneToMany",
			"target": "api::blog-post.blog-post",
			"mappedBy": "author"
		}
	}
}
